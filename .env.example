# Apenas desenvolvimento local com dados sintéticos. Não usar em produção.
# As rotas de saúde não abrem conexões; a camada de dados usa papel separado.
POSTGRES_PASSWORD=tato_local_exemplo
DATABASE_MIGRATION_URL=postgresql+psycopg://tato:tato_local_exemplo@127.0.0.1:5432/tato
DATABASE_URL=postgresql+psycopg://tato_app:troque_senha_local@127.0.0.1:5432/tato
# Gere duas chaves independentes de 32 bytes em base64. Não use a chave de JWT.
DATA_ENCRYPTION_KEY=
DEDUP_HMAC_KEY=
# Supabase de desenvolvimento: nunca coloque chave administrativa no frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Memória é permitida somente no desenvolvimento de um único processo.
TATO_ENV=development
RATE_LIMIT_BACKEND=memory
